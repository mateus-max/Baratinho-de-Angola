{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/share",
        "function": {
          "functionId": "socialPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/share-image",
        "function": {
          "functionId": "socialPreview",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "/share**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}
